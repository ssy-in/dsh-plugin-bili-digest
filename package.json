{
  "name": "dsh-plugin-bili-digest",
  "version": "0.1.0",
  "description": "字幕优先的 B 站视频阅读器：有字幕的只把关键段落交给模型，没有字幕的改用分镜截图。Subtitle-first Bilibili reader for DeepSeek Harness: feed the model only the dense caption segments, and fall back to storyboard screenshots when a video has no captions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./core": "./lib/core/digest.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "bili-digest": "bin/bili-digest.js"
  },
  "files": [
    "lib",
    "client",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node scripts/prepare-test.mjs && node test/core.test.js && node test/frames.test.js && node test/mood.test.js && node test/tone.test.js && node test/write.test.js && node test/inbox.test.js && node test/tagbook.test.js && node test/plugin.test.js && node test/client.test.js",
    "prepare": "node scripts/prepare-test.mjs",
    "smoke": "node bin/bili-digest.js --help"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "subtitle",
    "screenshot",
    "storyboard",
    "digest",
    "mood",
    "diary",
    "token-saving",
    "tags",
    "favorites"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "jpeg-js": "^0.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssy-in/dsh-plugin-bili-digest.git"
  },
  "homepage": "https://github.com/ssy-in/dsh-plugin-bili-digest#readme",
  "bugs": {
    "url": "https://github.com/ssy-in/dsh-plugin-bili-digest/issues"
  },
  "author": "ssy-in"
}
